generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Conexión directa (sin pooler) para las migraciones. La integración de Neon en Vercel la crea sola.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Persona que puede entrar al panel (la profesional, una secretaria, etc.)
model Administrador {
  id             String              @id @default(cuid())
  nombre         String
  email          String              @unique
  passwordHash   String
  activo         Boolean             @default(true)
  /// Sube cada vez que cambia la contraseña: cierra las sesiones abiertas en otros dispositivos
  version        Int                 @default(0)
  ultimoIngreso  DateTime?
  recuperaciones RecuperacionClave[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

/// Link de “Olvidé mi contraseña”: se guarda sólo el hash del código, vence en 1 hora y sirve una vez
model RecuperacionClave {
  id              String        @id @default(cuid())
  administradorId String
  administrador   Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  expiraEn        DateTime
  usadoEn         DateTime?
  createdAt       DateTime      @default(now())

  @@index([administradorId, createdAt])
}

/// Tratamiento que ofrece la profesional (limpieza facial, peeling, etc.)
model Servicio {
  id          String     @id @default(cuid())
  nombre      String
  descripcion String     @default("")
  categoria   String     @default("Faciales")
  duracionMin Int
  /// Precio en pesos argentinos (sin centavos)
  precio      Int
  activo      Boolean    @default(true)
  orden       Int        @default(0)
  turnos      Turno[]
  giftCards   GiftCard[]
  /// Combo / pack: incluye otros tratamientos y tiene precio propio
  esCombo     Boolean    @default(false)
  incluye     Servicio[] @relation("Combo")
  enCombos    Servicio[] @relation("Combo")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// Franja de atención semanal. Puede haber varias por día (ej: mañana y tarde).
model HorarioAtencion {
  id         String @id @default(cuid())
  /// 0 = domingo … 6 = sábado
  diaSemana  Int
  /// "HH:mm" en hora de Argentina
  horaInicio String
  horaFin    String
}

/// Período en el que no se toman turnos (vacaciones, feriados, trámites).
model Bloqueo {
  id     String   @id @default(cuid())
  desde  DateTime
  hasta  DateTime
  motivo String   @default("")
}

model Clienta {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  telefono  String
  /// Ficha: datos que la profesional completa desde el panel
  tipoPiel  String   @default("")
  alergias  String   @default("")
  notas     String   @default("")
  turnos    Turno[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EstadoTurno {
  PENDIENTE_PAGO
  CONFIRMADO
  CANCELADO
  COMPLETADO
  AUSENTE
}

model Turno {
  id                  String      @id @default(cuid())
  clientaId           String
  clienta             Clienta     @relation(fields: [clientaId], references: [id])
  servicioId          String
  servicio            Servicio    @relation(fields: [servicioId], references: [id])
  inicio              DateTime
  fin                 DateTime
  estado              EstadoTurno @default(PENDIENTE_PAGO)
  /// Precio y seña congelados al momento de reservar
  precio              Int
  montoSena           Int         @default(0)
  /// Si queda PENDIENTE_PAGO después de esta hora, el horario se libera
  expiraEn            DateTime?
  mpPreferenceId      String?
  mpPaymentId         String?
  pagoEstado          String?
  notasClienta        String      @default("")
  /// Token secreto para que la clienta vea/cancele su turno desde el mail
  token               String      @unique @default(cuid())
  recordatorioEnviado Boolean     @default(false)
  creadoPorAdmin      Boolean     @default(false)
  /// Gift card con la que se pagó (todo o parte) y cuánto se descontó de ella
  giftCardId          String?
  giftCard            GiftCard?   @relation(fields: [giftCardId], references: [id])
  montoGiftCard       Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([inicio])
  @@index([estado])
}

enum EstadoGiftCard {
  PENDIENTE_PAGO
  ACTIVA
  USADA
  ANULADA
}

/// Tarjeta de regalo: un monto (con saldo) o un tratamiento puntual
model GiftCard {
  id                String         @id @default(cuid())
  /// Lo que se ingresa al reservar, ej: HS-7K2M9Q
  codigo            String         @unique
  /// Token secreto del link para ver / imprimir la tarjeta
  token             String         @unique
  /// Si tiene tratamiento, vale por ese tratamiento; si no, es de monto
  servicioId        String?
  servicio          Servicio?      @relation(fields: [servicioId], references: [id])
  /// Valor al momento de comprarla (monto, o precio del tratamiento)
  monto             Int
  /// Lo que queda por usar (sólo en las de monto)
  saldo             Int
  para              String
  de                String
  mensaje           String         @default("")
  compradorEmail    String         @default("")
  compradorTelefono String         @default("")
  estado            EstadoGiftCard @default(PENDIENTE_PAGO)
  /// Se fija al activarla (cuando se cobra)
  venceEn           DateTime?
  activadaEn        DateTime?
  creadaPorAdmin    Boolean        @default(false)
  turnos            Turno[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([estado])
}

enum TipoSena {
  NINGUNA
  PORCENTAJE
  FIJO
}

/// Fila única (id = 1) con la configuración del negocio
model Configuracion {
  id                   Int      @id @default(1)
  nombreNegocio        String   @default("MC Healthy Skin")
  nombreProfesional    String   @default("")
  emailProfesional     String   @default("")
  whatsapp             String   @default("")
  instagram            String   @default("")
  direccion            String   @default("")
  sobreMi              String   @default("")
  /// URL de YouTube, Vimeo o un .mp4
  videoUrl             String   @default("")
  senaTipo             TipoSena @default(FIJO)
  /// Porcentaje (0-100) o monto fijo en pesos según senaTipo
  senaValor            Int      @default(10000)
  /// Horas que el horario queda apartado esperando que la clienta abone la seña por WhatsApp
  horasParaSena        Int      @default(24)
  /// Cada cuántos minutos se ofrecen horarios
  intervaloMin         Int      @default(30)
  anticipacionMinHoras Int      @default(3)
  diasMaxReserva       Int      @default(45)
  horasParaCancelar    Int      @default(24)
  politicaCancelacion  String   @default("Podés cancelar sin costo hasta 24 hs antes del turno. Pasado ese plazo la seña no se reintegra.")
  /// Gift cards: si se venden en la web, valor de la de monto y meses de validez
  giftcardsActivas     Boolean  @default(true)
  giftcardMonto        Int      @default(50000)
  giftcardMeses        Int      @default(2)
  updatedAt            DateTime @updatedAt
}
